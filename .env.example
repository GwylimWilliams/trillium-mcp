# Trillium MCP Server Configuration
# Copy this file to .env and fill in your values

# Trillium ETAPI URL (required)
# Must include the /etapi path
# Examples:
#   - Local instance: http://localhost:8080/etapi
#   - Remote instance: https://notes.example.com/etapi
TRILLIUM_API_URL=http://localhost:8080/etapi

# Trillium ETAPI token (required)
# Generate in Trilium: Options > ETAPI > Create Token
# This token has full access to your notes - keep it secure!
TRILLIUM_API_TOKEN=your-etapi-token-here

# Permissions (optional, default: READ)
# Controls which operations are allowed:
#   - READ: Only search, list, and get operations (safe, recommended default)
#   - READ;WRITE: Full access including create, update, and delete operations
#
# ⚠️ SECURITY WARNING: WRITE permission allows AI to modify and delete notes
# RECOMMENDED: Start with READ, only enable WRITE if you need it
TRILLIUM_PERMISSIONS=READ

# Verify SSL certificates (optional, default: false)
# Set to 'true' for production with valid SSL certificates
# Set to 'false' for self-signed certificates or local development
VERIFY_SSL=false

# Exports directory (optional, default: ~/Downloads/trillium-exports)
# Where to save exported notes and attachments when using notes_export or attachments_get_content
# The directory will be created automatically if it doesn't exist
# Examples:
#   - macOS/Linux: /Users/yourusername/Documents/trillium-exports
#   - Windows: C:\Users\yourusername\Documents\trillium-exports
# TRILLIUM_EXPORTS_DIR=/path/to/your/exports
