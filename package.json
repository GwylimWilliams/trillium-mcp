{
  "name": "@aimbitgmbh/trillium-mcp",
  "version": "0.1.0",
  "description": "MCP server for Trilium Notes - Provides LLM access to your notes",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "trillium-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx --import dotenv/config src/index.ts",
    "build": "node node_modules/typescript/bin/tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-assistant",
    "ai-integration",
    "trilium",
    "triliumnext",
    "notes",
    "knowledge-base",
    "knowledge-management",
    "etapi",
    "note-taking",
    "personal-knowledge"
  ],
  "author": "aimbit GmbH <info@aimbit.de> (https://aimbit.de)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimbitgmbh/trillium-mcp.git"
  },
  "homepage": "https://github.com/aimbitgmbh/trillium-mcp#readme",
  "bugs": {
    "url": "https://github.com/aimbitgmbh/trillium-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "dotenv": "^16.4.7",
    "marked": "^17.0.1",
    "turndown": "^7.2.2",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^25.0.3",
    "@types/turndown": "^5.0.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
